<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_habibah"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GajiKaryawanHabibah">

        <activity
            android:name=".MainActivityHabibah"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".GajiActivityHabibah" android:exported="false" />
        <activity android:name=".PetunjukActivityHabibah" android:exported="false" />
        <activity android:name=".TentangActivityHabibah" android:exported="false" />

    </application>

</manifest>
